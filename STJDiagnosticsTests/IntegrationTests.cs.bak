        #region Legacy Tests (保持向后兼容)

        [Test]
        public void CoreAnalysisComponents_ShouldWorkTogether()
        {
            // Arrange
            var rootCauseAnalyzer = new RootCauseAnalyzer();
            var typeRegistrationValidator = new TypeRegistrationValidator();
            var options = new JsonSerializerOptions
            {
                TypeInfoResolver = GameJsonContext.Default
            };

            // Act & Assert - 验证根本原因分析器
            var analysisResult = rootCauseAnalyzer.ValidateTypeRegistrationChain(typeof(string)).GetAwaiter().GetResult();
            Assert.That(analysisResult, Is.Not.Null);
            Assert.That(analysisResult.TypeRegistrations, Is.Not.Null);
            Assert.That(analysisResult.DependencyChain, Is.Not.Null);

            // Act & Assert - 验证类型注册验证器
            var validationResult = typeRegistrationValidator.ValidateEventEffectKindTableRegistration();
            Assert.That(validationResult, Is.Not.Null);
            Assert.That(validationResult.Metadata, Is.Not.Null);
            Assert.That(validationResult.Metadata.ContainsKey("EventEffectKindTableValidation"), Is.True);

            // Act & Assert - 验证JsonSerializerOptions验证
            var optionsResult = typeRegistrationValidator.ValidateJsonSerializerOptions(options);
            Assert.That(optionsResult, Is.Not.Null);
            Assert.That(optionsResult.Metadata, Is.Not.Null);
            Assert.That(optionsResult.Metadata.ContainsKey("OptionsValidation"), Is.True);

            // Act & Assert - 验证命名空间冲突检测
            var conflictResult = rootCauseAnalyzer.DetectNamespaceConflicts(typeof(object)).GetAwaiter().GetResult();
            Assert.That(conflictResult, Is.Not.Null);
        }

        [Test]
        public void EventEffectKindTable_AnalysisWorkflow_ShouldComplete()
        {
            // Arrange
            var rootCauseAnalyzer = new RootCauseAnalyzer();
            var typeRegistrationValidator = new TypeRegistrationValidator();
            var testJson = "{\"EventEffectKinds\":{\"1\":{\"ID\":1,\"Name\":\"TestEffect\"}}}";

            // Act - 执行完整的分析工作流
            var eventEffectKindTableValidation = typeRegistrationValidator.ValidateEventEffectKindTableRegistration();
            var jsonStructureValidation = rootCauseAnalyzer.ValidateJsonStructure(typeof(object), testJson).GetAwaiter().GetResult();
            var dependencyValidation = typeRegistrationValidator.ValidateDependentTypes(typeof(string));

            // Assert - 验证所有分析步骤都完成
            Assert.That(eventEffectKindTableValidation, Is.Not.Null);
            Assert.That(jsonStructureValidation, Is.Not.Null);
            Assert.That(dependencyValidation, Is.Not.Null);

            // 验证元数据完整性
            Assert.That(eventEffectKindTableValidation.Metadata.ContainsKey("EventEffectKindTableValidation"), Is.True);
            Assert.That(jsonStructureValidation.JsonAnalysis, Is.Not.Null);
            Assert.That(dependencyValidation.Metadata.ContainsKey("DependencyAnalysis"), Is.True);
        }

        [Test]
        public void DiagnosticSystem_ComponentsIntegration_ShouldBeReady()
        {
            // Arrange
            var rootCauseAnalyzer = new RootCauseAnalyzer();
            var typeRegistrationValidator = new TypeRegistrationValidator();

            // Act - 验证组件可以协同工作
            var analysisTask = rootCauseAnalyzer.ValidateTypeRegistrationChain(typeof(string));
            var validationResult = typeRegistrationValidator.ValidateEventEffectKindTableRegistration();
            var analysisResult = analysisTask.GetAwaiter().GetResult();

            // Assert - 验证系统准备就绪
            Assert.That(analysisResult, Is.Not.Null, "RootCauseAnalyzer应该能够分析类型注册链");
            Assert.That(validationResult, Is.Not.Null, "TypeRegistrationValidator应该能够验证EventEffectKindTable");
            
            // 验证错误处理
            Assert.That(analysisResult.TypeRegistrations, Is.Not.Null, "分析结果应该包含类型注册信息");
            Assert.That(validationResult.Errors, Is.Not.Null, "验证结果应该包含错误列表");
            Assert.That(validationResult.Warnings, Is.Not.Null, "验证结果应该包含警告列表");
        }

        #endregion
