<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    
    <!-- 🔥 2026-03-16 全局启用 AOT 兼容性检查 -->
    <!-- 在 IDE 编写代码和 Debug 编译时就标红 AOT 隐患 -->
    <IsAotCompatible>true</IsAotCompatible>
    
    <!-- 🔥 2026-02-12 减少 MonoGame Content Pipeline 输出 -->
    <MonoGameContentBuilderExeVerbosity>Quiet</MonoGameContentBuilderExeVerbosity>
    <MonoGameMGCBAdditionalArguments>/quiet</MonoGameMGCBAdditionalArguments>
    
    <!-- 🔥 2026-02-27 启用硬链接加速 Content 文件复制 -->
    <!-- 在同一分区下，瞬间完成文件"复制"（实际是创建硬链接） -->
    <CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>true</CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>
    
    <!-- 🔥 2026-02-27 跳过未修改文件的复制检查（进一步加速） -->
    <!-- 仅在文件真正变化时才触发复制操作 -->
    <UseCommonOutputDirectory>false</UseCommonOutputDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE;WINDOWS</DefineConstants>
    <Optimize>false</Optimize>
    
    <!-- 🔥 2026-03-16 Debug 模式启用完整 AOT 以复现 Release 问题 -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>partial</TrimMode>
    
    <!-- 🔥 2026-02-12 根本修复：显式启用源生成器文件输出 -->
    <!-- 这会强制源生成器将生成的文件写入磁盘，便于诊断 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
    
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE;WINDOWS</DefineConstants>
    <Optimize>true</Optimize>
    <!-- AOT Configuration -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 🔥 2026-02-12 根本修复：移除 SYSLIB1031 抑制，让源生成器错误可见 -->
    <!-- SYSLIB1031 是 JSON 源生成器的警告，抑制它会导致源生成器静默失败 -->
    <!-- 🔥 2026-03-19 抑制 CS8632：项目全局 Nullable=disable，但部分文件使用 #nullable enable -->
    <!-- 这是过渡期的临时方案，长期应全局启用 Nullable -->
    <NoWarn>$(NoWarn);SYSLIB0021;SYSLIB0041;SYSLIB0014;CS8981;CS0168;CS0219;CS0414;CS0649;CS0169;CS0162;CS0472;IL2026;IL3050;CA1416;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
    <PackageReference Include="MersenneTwister" Version="1.0.5" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.10" />
    <PackageReference Include="Monogame.Imgui.Renderer" Version="1.0.5" />
    <PackageReference Include="SharpCompress" Version="0.37.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

  </ItemGroup>

  <ItemGroup>
    <!-- Source Generator for texture assignment code generation -->
    <ProjectReference Include="..\WorldOfTheThreeKingdoms.SourceGenerators\WorldOfTheThreeKingdoms.SourceGenerators.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)monogame.framework.desktopgl\3.8.1.303\runtimes\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 🔥 MonoGame Content Pipeline 引用 -->
    <MonoGameContentReference Include="..\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </MonoGameContentReference>
    
    <!-- 🔥 2026-02-27 抑制 Content 文件复制的日志输出 -->
    <!-- 使用 Visible="false" 隐藏文件复制日志 -->
    <Content Include="..\Content\**">
      <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\ContentLite\**">
      <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>

    <None Update="Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
  <Target Name="KillProcessBeforeBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="taskkill /F /IM WorldOfTheThreeKingdoms.exe 2&gt;nul" IgnoreExitCode="true" />
  </Target>
  
  <!-- 🔥 2026-02-27 完全静默 Content 文件复制日志 -->
  <Target Name="SuppressContentCopyLogs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- 将所有 Content 项标记为不可见，阻止 VS 输出日志 -->
      <Content Update="@(Content)" Visible="false" />
    </ItemGroup>
  </Target>
</Project>