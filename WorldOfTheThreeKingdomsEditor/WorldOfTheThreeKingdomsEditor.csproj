<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>WorldOfTheThreeKingdomsEditor</RootNamespace>
    <AssemblyName>WorldOfTheThreeKingdomsEditor</AssemblyName>
    
    <!-- 禁用 SDK 自动生成的 AssemblyInfo 特性（使用手动的 Properties/AssemblyInfo.cs） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    
    <!-- 
      ⚠️ 重要说明：WPF 不支持 Native AOT 编译
      WPF 强依赖运行时反射和动态代码生成，因此不能启用 PublishAot。
      编辑器运行在标准 CoreCLR 上，但数据层（EditorDataManager、CommonDataLoader）
      通过调用主程序的 GameJsonContext 实现 AOT 兼容的序列化。
    -->
    <PublishAot>false</PublishAot>
    
    <!-- 可选：启用 ReadyToRun 优化（不是 Native AOT，但可提升启动速度） -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主程序项目引用 -->
    <ProjectReference Include="..\WorldOfTheThreeKingdoms\WorldOfTheThreeKingdoms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.5.1" />
  </ItemGroup>

</Project>
